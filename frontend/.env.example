BB_API_BASE_URL=http://localhost:8000
BB_REQUEST_TIMEOUT_SECONDS=5
BB_PUBLIC_SITE_MODE=true
BB_ENABLE_TRACE=true
BB_ENABLE_MARKET=true
BB_ENABLE_TIME_MACHINE=true
BB_ENABLE_CONSOLE=true
BB_ENABLE_SOVEREIGN_GRID=true
BB_DEFAULT_LANGUAGE=en
BB_LOG_LEVEL=INFO
BB_ACCESS_DEV_SIGNER_ENABLED=false
BB_ACCESS_PAYMENT_POLL_INTERVAL_MS=5000
BB_ACCESS_SESSION_REFRESH_SECONDS=300
BB_WALLET_AUTH_ENABLED=true
BB_WALLET_AUTH_REQUIRE_BIP322=true
BB_WALLET_AUTH_ALLOW_LEGACY_SIGNATURES=false
BB_LNURL_AUTH_ENABLED=true
BB_LNURL_PAY_ENABLED=true
BB_LNURL_WITHDRAW_ENABLED=true
BB_LIGHTNING_ADDRESS_ENABLED=true
# Compatibility aliases for deployment manifests; do not place secrets in frontend env.
BASTION_API_URL=http://localhost:8000
ACCESS_DEV_SIGNER_ENABLED=false
