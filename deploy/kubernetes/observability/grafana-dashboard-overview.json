{"title":"Bitcoin Bastion Overview","schemaVersion":39,"version":1,"panels":[{"type":"timeseries","title":"API Availability","targets":[{"expr":"up{job=\"bitcoin-bastion-api\"}"}]},{"type":"stat","title":"Readiness","targets":[{"expr":"probe_success{job=\"bitcoin-bastion-ready\"}"}]},{"type":"stat","title":"Liveness","targets":[{"expr":"probe_success{job=\"bitcoin-bastion-live\"}"}]},{"type":"timeseries","title":"Request Rate","targets":[{"expr":"sum(rate(http_requests_total[5m]))"}]},{"type":"timeseries","title":"Error Rate","targets":[{"expr":"sum(rate(http_requests_total{status=~\"5..\"}[5m]))"}]},{"type":"timeseries","title":"Latency p50/p95/p99","targets":[{"expr":"histogram_quantile(0.5,sum(rate(http_request_duration_seconds_bucket[5m])) by (le))"},{"expr":"histogram_quantile(0.95,sum(rate(http_request_duration_seconds_bucket[5m])) by (le))"},{"expr":"histogram_quantile(0.99,sum(rate(http_request_duration_seconds_bucket[5m])) by (le))"}]},{"type":"stat","title":"Degraded Mode","targets":[{"expr":"bitcoin_bastion_degraded_mode_active"}]},{"type":"stat","title":"Runtime Severity","targets":[{"expr":"bitcoin_bastion_runtime_severity_score"}]},{"type":"stat","title":"Provider Health","targets":[{"expr":"avg(bitcoin_bastion_provider_confidence)"}]},{"type":"stat","title":"Citadel Runtime Health","targets":[{"expr":"bitcoin_bastion_citadel_runtime_health"}]},{"type":"stat","title":"Unresolved Recovery Findings","targets":[{"expr":"bitcoin_bastion_unresolved_critical_findings"}]},{"type":"timeseries","title":"Delivery Failures","targets":[{"expr":"rate(bitcoin_bastion_delivery_failures_total[15m])"}]},{"type":"timeseries","title":"Worker Health","targets":[{"expr":"up{job=~\".*worker.*\"}"}]},{"type":"timeseries","title":"Evidence Job Status","targets":[{"expr":"kube_job_status_failed{namespace=~\"bitcoin-bastion.*\"}"}]}]}
