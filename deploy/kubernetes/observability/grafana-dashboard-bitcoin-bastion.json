{"title":"Bitcoin Bastion Runtime","schemaVersion":39,"version":1,"panels":[{"type":"timeseries","title":"API Availability","targets":[{"expr":"up{job=\"bitcoin-bastion-api\"}"}]},{"type":"timeseries","title":"Request Latency","targets":[{"expr":"histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))"}]},{"type":"timeseries","title":"Error Rate","targets":[{"expr":"sum(rate(http_requests_total{status=~\"5..\"}[5m]))"}]},{"type":"stat","title":"Degraded Mode","targets":[{"expr":"bitcoin_bastion_degraded_mode_active"}]},{"type":"stat","title":"Runtime Severity","targets":[{"expr":"bitcoin_bastion_runtime_severity_score"}]},{"type":"timeseries","title":"Provider Health","targets":[{"expr":"bitcoin_bastion_provider_status"}]},{"type":"stat","title":"Provider Fallback Active","targets":[{"expr":"bitcoin_bastion_provider_fallback_active"}]},{"type":"timeseries","title":"Provider Confidence","targets":[{"expr":"bitcoin_bastion_provider_confidence"}]},{"type":"timeseries","title":"Delivery Failures","targets":[{"expr":"rate(bitcoin_bastion_delivery_failures_total[15m])"}]},{"type":"stat","title":"Citadel Runtime Health","targets":[{"expr":"bitcoin_bastion_citadel_runtime_health"}]},{"type":"stat","title":"Unresolved Recovery Findings","targets":[{"expr":"bitcoin_bastion_unresolved_critical_findings"}]},{"type":"timeseries","title":"Celery Worker Health","targets":[{"expr":"up{job=~\".*worker.*\"}"}]},{"type":"timeseries","title":"PostgreSQL Health","targets":[{"expr":"pg_up"}]},{"type":"timeseries","title":"Redis Health","targets":[{"expr":"redis_up"}]}]}
