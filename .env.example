# Runtime mode (dev|prod)
ENVIRONMENT=dev
APP_NAME=Bitcoin Bastion
API_PREFIX=/api/v1

# Database/Redis
POSTGRES_DB=bitcoin_bastion
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres-password
DATABASE_URL=postgresql+psycopg://postgres:change-me-postgres-password@db:5432/bitcoin_bastion
REDIS_URL=redis://redis:6379/0

# Auth/JWT
JWT_SECRET_KEY=change-me-in-prod
JWT_ALGORITHM=HS256
JWT_ISSUER=bitcoin-bastion
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60

# Optional bot/integration values
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=
ADMIN_CHAT_IDS=
NEWS_FETCH_INTERVAL_SECONDS=300
ONCHAIN_LARGE_TRANSFER_SATS=1000000000
RATE_LIMIT_PER_MINUTE=120
