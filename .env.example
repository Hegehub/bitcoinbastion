APP_ENV=dev
DEBUG=true
DATABASE_URL=REPLACE_ME
REDIS_URL=REPLACE_ME
JWT_SECRET_KEY=REPLACE_ME
BB_API_BASE_URL=http://localhost:8000
BB_REQUEST_TIMEOUT_SECONDS=5
CORS_ALLOW_ORIGINS=http://localhost:3001
WEBHOOK_DISPATCH_ENABLED=true
WEBHOOK_DISPATCH_BATCH_SIZE=50
WEBHOOK_DISPATCH_TIMEOUT_SECONDS=5
WEBHOOK_DISPATCH_MAX_ATTEMPTS=8
WEBHOOK_DISPATCH_INITIAL_RETRY_SECONDS=30
WEBHOOK_DISPATCH_MAX_RETRY_SECONDS=3600
WEBHOOK_DISPATCH_RESPONSE_PREVIEW_BYTES=2048

# Developer layer hardening defaults
BB_WEBHOOK_TIMEOUT_SECONDS=5
BB_WEBHOOK_MAX_ATTEMPTS=5
BB_WEBHOOK_MAX_PAYLOAD_BYTES=65536
BB_WEBHOOK_SIGNATURE_TOLERANCE_SECONDS=300
BB_WEBHOOK_ALLOW_PRIVATE_NETWORK_TARGETS=false
BB_WS_MAX_TOPICS_PER_CONNECTION=8
BB_WS_MAX_PAYLOAD_BYTES=65536
BB_EVENTS_MAX_PAYLOAD_BYTES=65536
BB_EVENTS_MAX_METADATA_BYTES=16384
# Frontend runtime
BASTION_PRIMARY_FRONTEND=reflex

# Object storage foundation (local defaults are unsafe defaults; replace for production)
OBJECT_STORAGE_ENABLED=true
OBJECT_STORAGE_PROVIDER=minio
OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=bitcoin-bastion-artifacts
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_FORCE_PATH_STYLE=true
OBJECT_STORAGE_EVIDENCE_RETENTION_DAYS=2555
OBJECT_STORAGE_MAX_ARTIFACT_BYTES=104857600
OBJECT_STORAGE_ACCESS_KEY=REPLACE_ME
OBJECT_STORAGE_SECRET_KEY=REPLACE_ME
