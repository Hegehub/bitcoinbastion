APP_ENV=dev
DEBUG=true
DATABASE_URL=REPLACE_ME
REDIS_URL=REPLACE_ME
JWT_SECRET_KEY=REPLACE_ME
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
CORS_ALLOW_ORIGINS=http://localhost:3000
WEBHOOK_DISPATCH_ENABLED=true
WEBHOOK_DISPATCH_BATCH_SIZE=50
WEBHOOK_DISPATCH_TIMEOUT_SECONDS=5
WEBHOOK_DISPATCH_MAX_ATTEMPTS=8
WEBHOOK_DISPATCH_INITIAL_RETRY_SECONDS=30
WEBHOOK_DISPATCH_MAX_RETRY_SECONDS=3600
WEBHOOK_DISPATCH_RESPONSE_PREVIEW_BYTES=2048

# Developer layer hardening defaults
BB_WEBHOOK_TIMEOUT_SECONDS=5
BB_WEBHOOK_MAX_ATTEMPTS=5
BB_WEBHOOK_MAX_PAYLOAD_BYTES=65536
BB_WEBHOOK_SIGNATURE_TOLERANCE_SECONDS=300
BB_WEBHOOK_ALLOW_PRIVATE_NETWORK_TARGETS=false
BB_WS_MAX_TOPICS_PER_CONNECTION=8
BB_WS_MAX_PAYLOAD_BYTES=65536
BB_EVENTS_MAX_PAYLOAD_BYTES=65536
BB_EVENTS_MAX_METADATA_BYTES=16384

# Storage Layer foundation (configuration only; no future storage clients are connected yet)
# No seed phrases, Bitcoin private keys, wallet files, xprv/yprv/zprv, custody material,
# raw Access Pass bearer tokens, or raw secrets for vector storage should ever be stored here.
STORAGE_PROFILE=development

# PostgreSQL is the transactional source of truth. DATABASE_URL remains supported for compatibility;
# POSTGRES_URL is the canonical future name. In production, both must match if both are set.
POSTGRES_URL=
POSTGRES_READ_REPLICA_URL=
POSTGRES_SSL_MODE=prefer
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=10
POSTGRES_POOL_TIMEOUT_SECONDS=30
POSTGRES_STATEMENT_TIMEOUT_MS=30000

# Redis is not durable truth. It is only for cache, queues, rate limits, websocket fanout,
# idempotency windows, locks, and short-lived runtime state.
REDIS_TLS_ENABLED=false
REDIS_KEY_PREFIX=bitcoin_bastion
REDIS_EPHEMERAL_ONLY=true

# Object Storage stores proof/evidence artifacts; PostgreSQL stores artifact metadata,
# checksums, signatures, lifecycle state, retention state, and authorization policy.
OBJECT_STORAGE_ENABLED=false
OBJECT_STORAGE_PROVIDER=disabled
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_USE_SSL=true
OBJECT_STORAGE_FORCE_PATH_STYLE=true
OBJECT_STORAGE_DEFAULT_RETENTION_DAYS=90
OBJECT_STORAGE_WORM_ENABLED=false
OBJECT_STORAGE_CHECKSUM_REQUIRED=true

# TimescaleDB is future time-series storage for metrics, candles, provider/source health, and usage windows.
TIMESCALE_ENABLED=false
TIMESCALE_URL=
TIMESCALE_SCHEMA=timeseries
TIMESCALE_RETENTION_DAYS=
TIMESCALE_COMPRESSION_ENABLED=true
TIMESCALE_CONTINUOUS_AGGREGATES_ENABLED=true

# ClickHouse is analytics/projection only. It must not be used for transactional access decisions.
CLICKHOUSE_ENABLED=false
CLICKHOUSE_URL=
CLICKHOUSE_DATABASE=bitcoin_bastion
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=
CLICKHOUSE_SECURE=true
CLICKHOUSE_PROJECTION_LAG_WARN_SECONDS=300
CLICKHOUSE_PROJECTION_LAG_CRITICAL_SECONDS=900

# Qdrant/pgvector are semantic projection stores only. Do not embed sensitive material,
# raw secrets, custody material, or bearer access tokens into vector stores.
VECTOR_STORE_PROVIDER=disabled
QDRANT_ENABLED=false
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=bitcoin_bastion
PGVECTOR_ENABLED=false
EMBEDDING_MODEL_VERSION=
VECTOR_REDACTION_REQUIRED=true

# SQLite/DuckDB are local/offline stores for Desktop AI, PayRegister, offline nodes,
# exports, and reports. They are not global source of truth.
LOCAL_STORAGE_ENABLED=false
LOCAL_SQLITE_PATH=./data/local/bastion.sqlite3
LOCAL_DUCKDB_PATH=./data/local/bastion.duckdb
LOCAL_STORAGE_ENCRYPTION_REQUIRED=true
LOCAL_SYNC_LOG_ENABLED=true

# Storage health and degraded-mode controls.
STORAGE_HEALTH_ENABLED=true
STORAGE_DEGRADED_MODE_ENABLED=true
STORAGE_FAIL_FAST_ON_CRITICAL_MISSING=true
STORAGE_REQUIRE_OBJECT_STORAGE_IN_PRODUCTION=true
STORAGE_REQUIRE_BACKUP_EVIDENCE_IN_PRODUCTION=true
