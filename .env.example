APP_ENV=dev
DEBUG=true
DATABASE_URL=REPLACE_ME
REDIS_URL=REPLACE_ME
# Legacy JWT auth is disabled; retained only for transitional non-auth tooling if needed.
# JWT_SECRET_KEY=LEGACY_DISABLED
BB_API_BASE_URL=http://localhost:8000
BB_REQUEST_TIMEOUT_SECONDS=5
CORS_ALLOW_ORIGINS=http://localhost:3001
WEBHOOK_DISPATCH_ENABLED=true
WEBHOOK_DISPATCH_BATCH_SIZE=50
WEBHOOK_DISPATCH_TIMEOUT_SECONDS=5
WEBHOOK_DISPATCH_MAX_ATTEMPTS=8
WEBHOOK_DISPATCH_INITIAL_RETRY_SECONDS=30
WEBHOOK_DISPATCH_MAX_RETRY_SECONDS=3600
WEBHOOK_DISPATCH_RESPONSE_PREVIEW_BYTES=2048

# Developer layer hardening defaults
BB_WEBHOOK_TIMEOUT_SECONDS=5
BB_WEBHOOK_MAX_ATTEMPTS=5
BB_WEBHOOK_MAX_PAYLOAD_BYTES=65536
BB_WEBHOOK_SIGNATURE_TOLERANCE_SECONDS=300
BB_WEBHOOK_ALLOW_PRIVATE_NETWORK_TARGETS=false
BB_WS_MAX_TOPICS_PER_CONNECTION=8
BB_WS_MAX_PAYLOAD_BYTES=65536
BB_EVENTS_MAX_PAYLOAD_BYTES=65536
BB_EVENTS_MAX_METADATA_BYTES=16384
# Frontend runtime
BASTION_PRIMARY_FRONTEND=reflex

# Object storage foundation (local defaults are unsafe defaults; replace for production)
OBJECT_STORAGE_ENABLED=true
OBJECT_STORAGE_PROVIDER=minio
OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=bitcoin-bastion-artifacts
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_FORCE_PATH_STYLE=true
OBJECT_STORAGE_EVIDENCE_RETENTION_DAYS=2555
OBJECT_STORAGE_MAX_ARTIFACT_BYTES=104857600
OBJECT_STORAGE_ACCESS_KEY=REPLACE_ME
OBJECT_STORAGE_SECRET_KEY=REPLACE_ME
# Bastion Proof-of-Access issuer signing configuration
# ACCESS_ISSUER_PRIVATE_KEY is secret material. Production must inject it from a
# secret manager or Kubernetes secret, never from a committed file.
ACCESS_SERVER_PEPPER=change-me-generate-strong-random-secret
ACCESS_ISSUER_KEY_ID=access-issuer-dev
ACCESS_ISSUER_PRIVATE_KEY=dev-only-do-not-use-in-production
ACCESS_CRYPTO_EPOCH=1
ACCESS_SIGNATURE_ALG=ed25519
# Access payment provider foundation
ACCESS_ALLOW_MANUAL_GRANTS=false
ACCESS_DEFAULT_PAYMENT_PROVIDER=manual
ACCESS_PAYMENT_INTENT_TTL_SECONDS=900
ACCESS_CHALLENGE_TTL_SECONDS=300
ACCESS_SESSION_TTL_SECONDS=900
ACCESS_REQUEST_MAX_SKEW_SECONDS=120
ACCESS_REQUEST_MAX_CLOCK_SKEW_SECONDS=120
ACCESS_REQUEST_SIGNATURE_REQUIRED=true
# Access BTCPay Server provider (disabled by default; secrets must come from secret manager in production)
ACCESS_BTCPAY_ENABLED=false
ACCESS_BTCPAY_BASE_URL=
ACCESS_BTCPAY_API_KEY=
ACCESS_BTCPAY_STORE_ID=
ACCESS_BTCPAY_WEBHOOK_SECRET=
ACCESS_BTCPAY_DEFAULT_CURRENCY=BTC
ACCESS_BTCPAY_CHECKOUT_EXPIRY_MINUTES=30
ACCESS_BTCPAY_HTTP_TIMEOUT_SECONDS=10
ACCESS_BTCPAY_WEBHOOK_TOLERANCE_SECONDS=300

# Access recovery (Bastion Recovery Seed, not a Bitcoin wallet seed)
ACCESS_RECOVERY_ENABLED=true
ACCESS_RECOVERY_COOLDOWN_SECONDS=86400
ACCESS_RECOVERY_MAX_ATTEMPTS_PER_HOUR=5
ACCESS_RECOVERY_REQUIRE_QUORUM_FOR_PRO=true
ACCESS_RECOVERY_REQUIRE_QUORUM_FOR_BUSINESS=true
ACCESS_RECOVERY_REQUIRE_QUORUM_FOR_ENTERPRISE=true
ACCESS_RECOVERY_REJECT_BITCOIN_SEED_INPUTS=true

ACCESS_LOCKDOWN_REQUIRE_STEP_UP=true
ACCESS_PQ_ENABLED=false
ACCESS_ML_DSA_ENABLED=false
ACCESS_ML_KEM_ENABLED=false
ACCESS_SLH_DSA_ENABLED=false

# LNURL entitlement binding (no secrets; production values must come from config management)
LNURL_ENTITLEMENT_BINDING_ENABLED=true
LNURL_ENTITLEMENT_ACTIVATION_TTL_SECONDS=900
LNURL_ENTITLEMENT_MAX_ACTIVATION_ATTEMPTS=5
LNURL_ENTITLEMENT_REQUIRE_PRINCIPAL=true
LNURL_ENTITLEMENT_ALLOW_PENDING_RESERVATIONS=true
LNURL_ENTITLEMENT_OVERPAYMENT_POLICY=accept_record_overpayment
LNURL_ENTITLEMENT_QUOTE_MAX_AGE_SECONDS=900
LNURL_ENTITLEMENT_RETRY_MAX_ATTEMPTS=3

# LNURL successAction activation UX (no real secrets in examples)
LNURL_SUCCESS_ACTION_ENABLED=true
LNURL_SUCCESS_ACTION_DEFAULT_TYPE=url
LNURL_SUCCESS_ACTION_BASE_URL=https://bastion.example.com
LNURL_SUCCESS_ACTION_ALLOWED_HOSTS=bastion.example.com
LNURL_ACTIVATION_TTL_SECONDS=3600
LNURL_ACTIVATION_MAX_TTL_SECONDS=86400
LNURL_ACTIVATION_SERVER_PEPPER=change-me-lnurl-activation-pepper
LNURL_SUCCESS_ACTION_ONION_MODE_ENABLED=false
LNURL_PUBLIC_RECEIPTS_ENABLED=true
LNURL_VAULT_SETUP_LINKS_ENABLED=false

# LNURL-pay comments (commentAllowed) -- comments are untrusted metadata
LNURL_COMMENT_ALLOWED_DEFAULT=0
LNURL_COMMENT_GLOBAL_MAX_CHARS=280
LNURL_COMMENT_GLOBAL_MAX_BYTES=2048
LNURL_COMMENT_STORAGE_ENABLED=false
LNURL_COMMENT_RETENTION_DAYS=7
LNURL_COMMENT_ALLOW_CONTROL_CHARACTERS=false

# LNURL payerData.auth defaults (privacy-preserving; no personal payer fields)
LNURL_PAYERDATA_AUTH_ENABLED=true
LNURL_PAYERDATA_AUTH_DEFAULT_MODE=required
LNURL_PAYERDATA_MAX_BYTES=4096
LNURL_PAYERDATA_AUTH_TTL_SECONDS=300
LNURL_PAYERDATA_STORE_RAW=false
LNURL_PAYERDATA_ALLOW_EMAIL=false
LNURL_PAYERDATA_ALLOW_NAME=false
LNURL_PAYERDATA_ALLOW_IDENTIFIER=false
LNURL_PAYERDATA_ALLOW_PUBKEY=false

# LNURL Lightning Address internal service (public route added in Prompt 38)
LNURL_LIGHTNING_ADDRESS_ENABLED=true
LNURL_PRIMARY_DOMAIN=bitcoin-bastion.com
LNURL_PAYREGISTER_DOMAIN=payregister.bitcoin-bastion.com
LNURL_ALLOWED_CUSTOM_DOMAINS=
LNURL_ALLOW_ONION_ADDRESSES=false
LNURL_LIGHTNING_ADDRESS_DEFAULT_MIN_MSAT=1000
LNURL_LIGHTNING_ADDRESS_DEFAULT_MAX_MSAT=10000000

# LNURL Lightning Address public discovery routes
LNURL_PUBLIC_BASE_URL=https://bitcoin-bastion.com
LNURL_CALLBACK_BASE_URL=https://bitcoin-bastion.com
LNURL_ALLOWED_PUBLIC_HOSTS=bitcoin-bastion.com,payregister.bitcoin-bastion.com
LNURL_LIGHTNING_ADDRESS_RATE_LIMIT_PER_MINUTE=120

# LNURL product Lightning Addresses
LNURL_PRODUCT_ADDRESSES_ENABLED=true
LNURL_PRODUCT_ADDRESS_DOMAIN=bitcoin-bastion.com
LNURL_PRODUCT_CONFIG_PATH=config/lnurl_product_addresses.yaml
LNURL_PRODUCT_CALLBACK_BASE_URL=https://bitcoin-bastion.com
LNURL_PRODUCT_ACTIVATION_BASE_URL=https://bitcoin-bastion.com
LNURL_ENTERPRISE_PUBLIC_PAYMENT_ENABLED=false
LNURL_PRODUCT_RESPONSE_CACHE_SECONDS=120
# PayRegister LNURL static QR/NFC (no secrets; example defaults only)
PAYREGISTER_LNURL_STATIC_ENABLED=true
PAYREGISTER_LNURL_PUBLIC_BASE_URL=https://payregister.bitcoin-bastion.com
PAYREGISTER_LNURL_CALLBACK_BASE_URL=https://payregister.bitcoin-bastion.com
PAYREGISTER_LNURL_CONTEXT_TTL_SECONDS=300
PAYREGISTER_LNURL_COMMENT_ALLOWED_DEFAULT=0
PAYREGISTER_LNURL_PAYERDATA_AUTH_MODE=optional
PAYREGISTER_LNURL_ALLOW_ONION=false
# Merchant Lightning Address (safe placeholders; no node secrets)
MERCHANT_LN_ADDRESS_ENABLED=true
MERCHANT_LN_CUSTOM_DOMAINS_ENABLED=false
MERCHANT_LN_DOMAIN_VERIFY_TTL_SECONDS=900
MERCHANT_LN_DOMAIN_RECHECK_INTERVAL_SECONDS=86400
MERCHANT_LN_DOMAIN_GRACE_PERIOD_SECONDS=259200
MERCHANT_LN_HTTP_VERIFY_MAX_REDIRECTS=2
MERCHANT_LN_HTTP_VERIFY_MAX_RESPONSE_BYTES=4096
MERCHANT_LN_PUBLIC_RATE_LIMIT_PER_MINUTE=60
MERCHANT_LN_CALLBACK_RATE_LIMIT_PER_MINUTE=30
MERCHANT_LN_ALLOW_OPERATOR_APPROVAL=false
MERCHANT_LN_ALLOW_ONION=false
# LNURL Receipt Packet (no secrets; signing key comes from issuer secret provider)
LNURL_RECEIPT_SIGNING_ENABLED=true
LNURL_RECEIPT_SCHEMA_EPOCH=1
LNURL_RECEIPT_PUBLIC_EXPORT_ENABLED=false
LNURL_RECEIPT_STORE_SANITIZED_COMMENTS=false
LNURL_RECEIPT_INCLUDE_PREIMAGE_HASH=true
LNURL_RECEIPT_RETENTION_DAYS=365
LNURL_RECEIPT_MAX_COMMENT_LENGTH=256
# LNURL-withdraw request creation (no node/payment-provider secrets)
LNURL_WITHDRAW_ENABLED=false
LNURL_WITHDRAW_CALLBACK_BASE_URL=https://bitcoin-bastion.com
LNURL_WITHDRAW_DEFAULT_TTL_SECONDS=300
LNURL_WITHDRAW_MAX_TTL_SECONDS=900
LNURL_WITHDRAW_GLOBAL_MAX_MSAT=10000000
LNURL_WITHDRAW_REQUIRE_POLICY=true
LNURL_WITHDRAW_ALLOW_TEST_FAUCET=false
LNURL_WITHDRAW_ONION_ENABLED=false

# LNURL withdraw risk controls (fail closed by default)
LNURL_WITHDRAW_MAINNET_ENABLED=false
LNURL_WITHDRAW_MAX_SINGLE_MSAT=5000000
LNURL_WITHDRAW_MAX_DAILY_PRINCIPAL_MSAT=500000
LNURL_WITHDRAW_MAX_DAILY_BUSINESS_MSAT=50000000
LNURL_WITHDRAW_MAX_DAILY_MERCHANT_MSAT=20000000
LNURL_WITHDRAW_MAX_DAILY_GLOBAL_MSAT=50000000
LNURL_WITHDRAW_MAX_REQUESTS_PER_HOUR=20
LNURL_WITHDRAW_MAX_REQUESTS_PER_DAY=100
LNURL_WITHDRAW_COOLDOWN_SECONDS=300
LNURL_WITHDRAW_HIGH_RISK_COOLDOWN_SECONDS=900
LNURL_WITHDRAW_REQUIRE_STEP_UP_ABOVE_MSAT=1000000
LNURL_WITHDRAW_REQUIRE_MANUAL_REVIEW_ABOVE_MSAT=5000000
LNURL_WITHDRAW_REQUIRE_ORIGINAL_PAYMENT=true
LNURL_WITHDRAW_MAX_REFUND_PERCENT=100
LNURL_WITHDRAW_ALLOW_PARTIAL_REFUNDS=true
LNURL_WITHDRAW_ALLOW_OVER_REFUNDS=false
LNURL_WITHDRAW_PROVIDER_TIMEOUT_SECONDS=30
LNURL_WITHDRAW_RECONCILIATION_ENABLED=true
# Authoritative Access revocation registry (set a unique production secret).
ACCESS_REVOCATION_PEPPER=change-me-in-production
ACCESS_REVOCATION_FAIL_CLOSED=true
ACCESS_REVOCATION_CACHE_TTL_SECONDS=30
ACCESS_REVOCATION_PROPAGATION_ENABLED=true
ACCESS_REVOCATION_PROPAGATION_BATCH_SIZE=100
LNURL_K1_REPLAY_LOCKOUT_ENABLED=true
LNURL_K1_REPLAY_RISK_INCREMENT=20
OFFLINE_PACK_MAX_REVOCATION_AGE_SECONDS=900
RECOVERY_CAPSULE_ENABLED=true
RECOVERY_CAPSULE_TTL_SECONDS=604800
RECOVERY_MAX_ATTEMPTS=5
RECOVERY_MAX_CAPSULES_PER_DAY=3
RECOVERY_LITE_BASIC_COOLDOWN_SECONDS=1800
RECOVERY_PLUS_COOLDOWN_SECONDS=7200
RECOVERY_PRO_COOLDOWN_SECONDS=21600
RECOVERY_BUSINESS_COOLDOWN_SECONDS=43200
RECOVERY_ENTERPRISE_COOLDOWN_SECONDS=86400
RECOVERY_SOVEREIGN_COOLDOWN_SECONDS=172800
RECOVERY_REVOKE_ALL_SESSIONS_ON_SUCCESS=true
RECOVERY_FREEZE_CHILD_KEYS_ON_SUCCESS=true
RECOVERY_REQUIRE_TRUSTED_DEVICE_FOR_PRO=true
RECOVERY_REQUIRE_QUORUM_FOR_BUSINESS=true
RECOVERY_REQUIRE_QUORUM_FOR_ENTERPRISE=true
RECOVERY_REQUIRE_TRANSPARENCY_FOR_SOVEREIGN=true
WALLET_AUTH_RECOVERY_LNURL_ENABLED=true
WALLET_AUTH_RECOVERY_LNURL_TTL_SECONDS=300
WALLET_AUTH_RECOVERY_LNURL_MAX_ATTEMPTS=5
WALLET_AUTH_RECOVERY_REQUIRE_ADDITIONAL_FACTOR=true
WALLET_AUTH_RECOVERY_LNURL_DOMAIN=auth.bitcoin-bastion.com
WALLET_AUTH_RECOVERY_LNURL_ALLOW_COMPATIBILITY_PROOF=false
WALLET_QUORUM_ENABLED=true
WALLET_QUORUM_DEFAULT_TTL_SECONDS=300
WALLET_QUORUM_MAX_PARTICIPANTS=10
WALLET_QUORUM_FAIL_CLOSED=true
WALLET_QUORUM_REQUIRE_HUMAN_INTENT=true
WALLET_QUORUM_REQUIRE_POP_SESSION=true
ACCESS_PRINCIPAL_CERTIFICATES_ENABLED=true
ACCESS_CERTIFICATE_DEFAULT_TTL_SECONDS=86400
ACCESS_CERTIFICATE_MAX_TTL_SECONDS=2592000
ACCESS_CERTIFICATE_EXPORT_ENABLED=false
ACCESS_CERTIFICATE_LEGACY_MIGRATION_MODE=restricted
ACCESS_CERTIFICATE_REQUIRE_STEP_UP_FOR_EXPORT=true
ACCESS_CERTIFICATE_REQUIRE_HIGH_ASSURANCE_FOR_OFFLINE=true
OFFLINE_PACKS_ENABLED=false
OFFLINE_PACK_DEFAULT_TTL_SECONDS=14400
OFFLINE_PACK_PRO_MAX_TTL_SECONDS=43200
OFFLINE_PACK_BUSINESS_MAX_TTL_SECONDS=43200
OFFLINE_PACK_MAX_PENDING_EVENTS=1000
OFFLINE_PACK_REQUIRE_ACCESS_CERTIFICATE_FOR_BUSINESS=true
OFFLINE_PACK_REQUIRE_STEP_UP_FOR_PRO=true
OFFLINE_PACK_CLOCK_ROLLBACK_TOLERANCE_SECONDS=60
OFFLINE_PACK_RECONCILIATION_GRACE_SECONDS=900
ACCESS_CRYPTO_EPOCH=1
ACCESS_CLASSICAL_SIGNATURE_ALGORITHM=ed25519
ACCESS_SIGNATURE_REQUIREMENT_POLICY=classical_required_pq_optional
ACCESS_ISSUER_KEY_ID=access-issuer-v1
ACCESS_ISSUER_PRIVATE_KEY_PROVIDER=environment
ACCESS_PQ_ENABLED=false
ACCESS_PQ_SIGNATURE_ALGORITHM=ml_dsa_65
ACCESS_PQ_ISSUER_KEY_ID=
ACCESS_PQ_PRIVATE_KEY_PROVIDER=disabled
ACCESS_CRYPTO_FAIL_CLOSED=true
TRANSPARENCY_CHECKPOINTS_ENABLED=true
TRANSPARENCY_DEFAULT_HASH_SUITE=sha256
TRANSPARENCY_REQUIRE_CLASSICAL_SIGNATURE=true
TRANSPARENCY_REQUIRE_PQ_SIGNATURE=false
TRANSPARENCY_PUBLICATION_ENABLED=false
TRANSPARENCY_PUBLICATION_TARGET=internal
TRANSPARENCY_MAX_BATCH_SIZE=10000
TRANSPARENCY_RETENTION_DAYS=2555
TRANSPARENCY_ALLOW_PUBLIC_SAFE_EXPORT=true
